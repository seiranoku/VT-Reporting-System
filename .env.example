# PostgreSQL
POSTGRES_DB=vt_db
POSTGRES_USER=vt_user
POSTGRES_PASSWORD=vt_password

# Backend
DATABASE_URL=postgresql://vt_user:vt_password@postgres:5432/vt_db
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
STORAGE_PATH=/storage/evidence
MAX_FILE_SIZE_MB=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
# Used by Next.js server-side fetch inside Docker network
API_INTERNAL_URL=http://backend:3001
